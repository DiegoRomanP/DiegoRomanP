{
  "name": "diegoromanp-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/check-profile-data.mjs && npm run readme:check",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -v",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "stats:update": "node scripts/update-github-stats.mjs",
    "readme:generate": "node scripts/render-readme.mjs",
    "readme:check": "node scripts/render-readme.mjs --check",
    "check:budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "motion": "14.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
